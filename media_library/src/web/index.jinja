<!DOCTYPE html>
<html>
    <head>
        <title>Media Library</title>
        <link rel="stylesheet" href="web/index.css">
    </head>
    <body>

    <div hidden id="fullscreen_photo_div">
        <h1>This is a test modal</h1>
        <p>image would go here</p>
        <img src="example.com" id="hidden_img" onclick="unFullscreenPhoto()"/>
        <button>Close</button>
        <button>Download</button>
        <button>Delete</button>
    </div>

    <div id="fullscreen_video_div" ></div>

    <div id="main_div">

        <h1>Media Library</h1>

        <h2 id="upload_h2" onclick="toggleCollapse(this.id, 'upload_div')">Upload +</h2>
        <div id="upload_div" class="collapsible">
            <input id="file_input" type="file" multiple/>
            <button id="upload_button" onclick="upload()">Upload</button>
            <p id="upload_message"></p>
            <button onclick="deleteEverything()">Delete Everything</button>
        </div>

        <h2 id="filter_h2" onclick="toggleCollapse(this.id, 'filter_div')">Filter +</h2>
        <div id="filter_div" class="collapsible">
            <label for="type_input">Type</label>
            <select id="type_input">
                {% if typ == 'all' %}
                    <option value="all" selected>All</option>
                {% else %}
                    <option value="all">All</option>
                {% endif %}

                {% if typ == 'photo' %}
                    <option value="photo" selected>Photo</option>
                {% else %}
                    <option value="photo">Photo</option>
                {% endif %}

                {% if typ == 'video' %}
                    <option value="video" selected>Video</option>
                {% else %}
                    <option value="video">Video</option>
                {% endif %}
            </select><br/>

            <label for="year_input">Year</label>
            <input id="year_input" value="{{ year }}"/><br/>
            <label for="month_input">Month</label>
            <input id="month_input" value="{{ month }}"/><br/>
            <label for="day_input">Day</label>
            <input id = "day_input" value="{{ day }}"/><br/>
            <button id="filter_button" onclick="filter()">Filter</button>
        </div>

        <div id="navigation">
            <div id="page_left_div"><button id="pageLeft" onclick="pageLeft()">&lt</button></div>
                <span id="page">{{ page }} / {{ max_page }}</span>
            <div id="page_right_div"><button id="pageRight" onclick="pageRight()">&gt</button></div>

            <div id="zoom_div">
                <button id="zoomIn" onclick="zoomIn()">+</button>
                <button id="zoomOut" onclick="zoomOut()">-</button>
            </div>
        </div>

        <div id="image_container">
            {% for item in data %}
            <div class="media_item">
                {% if item.type == 'photo' %}
                    <img class="tile_img" src="{{ item.path }}" onclick="fullscreenPhoto(this.src)"/>
                {% else %}
                    <div class="video_div">
                        <video class="tile_video" onclick="fullscreenVideo(this.src, `video`)">
                            <source src="{{ item.path }}" type="video/mp4">
                        </video>
                        <span class="video_icon">VIDEO</span>
                    </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        
        <p hidden id="hidden_page">{{ page }}</p>
        <p hidden id="hidden_max_page">{{ max_page }}</p>
        <p hidden id="hidden_typ">{{ typ }}</p>
        <p hidden id="hidden_year">{{ year }}</p>
        <p hidden id="hidden_month">{{ month }}</p>
        <p hidden id="hidden_day">{{ day }}</p>
        <p hidden id="hidden_zoom">{{ zoom }}</p>

        <script src="web/index.js"></script>

    </div>
    </body>
</html>