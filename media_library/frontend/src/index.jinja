<!DOCTYPE html>
<html>
    <head>
        <title>Media Library</title>
    </head>
    <body>

        <h1>Media Library</h1>

        <label for="type_input">Type</label>
        <select id="type_input">
            {% if typ == 'all' %}
                <option value="all" selected>All</option>
            {% else %}
                <option value="all">All</option>
            {% endif %}

            {% if typ == 'photo' %}
                <option value="photo" selected>Photo</option>
            {% else %}
                <option value="photo">Photo</option>
            {% endif %}

            {% if typ == 'video' %}
                <option value="video" selected>Video</option>
            {% else %}
                <option value="video">Video</option>
            {% endif %}
        </select>

        <label for="year_input">Year</label>
        <input id="year_input" value="{{ year }}"/>
        <label for="month_input">Month</label>
        <input id="month_input" value="{{ month }}"/>
        <label for="day_input">Day</label>
        <input id = "day_input" value="{{ day }}"/>
        <button id="filter_button" onclick="filter()">Filter</button>

        <br/>

        <button id="pageLeft" onclick="pageLeft()">&lt</button>
        <span id="page">{{ page }} / {{ (count // 50)|round(0, 'ceil') }}</span>
        <button id="pageLeft" onclick="pageRight()">&gt</button>

        {% for item in data %}
        <div>
            {% if item.type == 'photo' %}
                <img src="{{ item.path }}"/>
            {% else %}
                <video controls>
                    <source src="{{ item.path }}" type="video/mp4">
                </video>
            {% endif %}
            <p>{{item.date}}</p>
        </div>
        {% endfor %}

        <button id="pageLeft" onclick="pageLeft()">&lt</button>
        <span id="page">{{ page }} / {{ (count // 50)|round(0, 'ceil') }}</span>
        <button id="pageLeft" onclick="pageRight()">&gt</button>

        <p hidden id="hidden_page">{{ page }}</p>
        <p hidden id="hidden_max_page">{{ (count // 50)|round(0, 'ceil') }}</p>
        <p hidden id="hidden_typ">{{ typ }}</p>
        <p hidden id="hidden_year">{{ year }}</p>
        <p hidden id="hidden_month">{{ month }}</p>
        <p hidden id="hidden_day">{{ day }}</p>

    </body>
    <style>
img {
    max-width: 25%;
}
video {
    max-width: 25%;
}
    </style>
    <script>
function getJinjaVariables() {
    page =  Number.parseInt(document.getElementById("hidden_page").textContent)
    max_page = Number.parseInt(document.getElementById("hidden_max_page").textContent)
    typ =  document.getElementById("hidden_typ").textContent
    year = Number.parseInt(document.getElementById("hidden_year").textContent)
    month = Number.parseInt(document.getElementById("hidden_month").textContent)
    day = Number.parseInt(document.getElementById("hidden_day").textContent)
    return {page, typ, year, month, day, max_page}
}

function pageLeft() {
    vars = getJinjaVariables()
    if (page > 0) window.location.href = `/?page=${vars.page - 1}&typ=${vars.typ}&year=${vars.year}&month=${vars.month}&day=${vars.day}`
}

function pageRight() {
    vars = getJinjaVariables()
    if (page < vars.max_page) window.location.href = `/?page=${vars.page + 1}&typ=${vars.typ}&year=${vars.year}&month=${vars.month}&day=${vars.day}`
}

function filter() {
    typ = document.getElementById("type_input").value
    year = Number.parseInt(document.getElementById("year_input").value)
    month = Number.parseInt(document.getElementById("month_input").value)
    day = Number.parseInt(document.getElementById("year_input").value)

    window.location.href = `/?page=0&typ=${typ}&year=${year}&month=${month}&day=${day}`
}
    </script>
</html>