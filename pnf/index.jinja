<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <title>PNFSOD</title>
        <meta name="description" content="">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="">
    </head>
    <body class="app">
        <div class="content">
            <h1 class="pageTitle">Phineas and Ferb Song of the Day</h1>
            <p class="songOfTheDay">The song of the day today is...<p>
            <div class="songDiv">
                <img class="cover" alt="{{altText}}" src="{{image}}">
                <p ><span class="trackTitle">"{{name}}"</span> <br><a href="{{url}}">(listen on spotify)</a></p>
                <p class="artists">by {% for artist in artists %}
                    {{artist}},
                    {% endfor %}</p>
            </div>
        </div>
        <p class="whiteText">NEXT SONG DROPS -> <span id="timer"></span></p>
    </body>
    <style>
        @font-face {
            font-family: BoldDoodle;
            src: url("fonts/bolddoodle.ttf");
        }
        @font-face {
            font-family: bilderberg;
            src: url("fonts/bilderberg.otf");
        }
        @font-face {
            font-family: eroded;
            src: url("fonts/eroded.ttf");
        }
        @font-face {
            font-family: orangeave;
            src: url("fonts/orangeave.otf");
        }
        .app {
            background-color: purple;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .pageTitle{
            font-family: eroded;
            font-size: 400%;
        }
        .songOfTheDay {
            font-family: orangeave;
            font-size: 150%;
        }
        .trackTitle {
            font-family: bolddoodle;
            font-size: 200%;
        }
        .content {
            border-left: 20px groove orange;
            border-right: 20px groove orange;
            background-color: yellow;
            padding: 2%;
            border-style: ;
        }
        .cover {
            max-width: 50%;
        }
        .songDiv {
            padding: 1%;
            border: 5px dotted black;
        }
        .artists {
            font-family: bilderberg;
        }
        .whiteText{
            color: white;
        }
        
        @media (max-width: 768px) {
            .pageTitle {
            font-size: 300%;
            }
        
        .cover {
            max-width: 100%;
        }
        }
    </style>
    <script>
        const tomorrow = new Date();
        tomorrow.setUTCDate(tomorrow.getUTCDate() + 1);
        tomorrow.setUTCHours(0, 0, 0, 0);
        var x = setInterval(function() {
            var now = new Date().getTime();
            var distance = tomorrow - now;
            var seconds = Math.floor(distance / 1000);
            document.getElementById("timer").innerHTML = seconds;
            if (distance < 0) {
                clearInterval(x);
                document.getElementById("demo").innerHTML = "NOW! REFRESH!";
            }
        }, 1000);

    </script>
</html>